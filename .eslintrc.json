{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks", "jsx-a11y", "check-file"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react/jsx-runtime",
    "plugin:react-hooks/recommended",
    "plugin:jsx-a11y/recommended",
    "prettier"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "ignorePatterns": ["build", "coverage", "node_modules", "public", "*.config.mjs"],
  "rules": {
    "eqeqeq": ["error", "smart"],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-param-reassign": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/naming-convention": [
      "error",
      {
        "selector": "import",
        "format": ["camelCase", "PascalCase"]
      },
      {
        "selector": "default",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "variable",
        "format": ["camelCase", "UPPER_CASE", "PascalCase"],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "parameter",
        "format": ["camelCase"],
        "leadingUnderscore": "allow"
      },
      {
        "selector": "function",
        "format": ["camelCase", "PascalCase"]
      },
      {
        "selector": "typeLike",
        "format": ["PascalCase"]
      },
      {
        "selector": "interface",
        "format": ["PascalCase"],
        "custom": {
          "regex": "^I[A-Z]",
          "match": false
        }
      },
      {
        "selector": "enum",
        "format": ["PascalCase"]
      },
      {
        "selector": "enumMember",
        "format": ["PascalCase"]
      },
      {
        "selector": "typeParameter",
        "format": ["PascalCase"],
        "prefix": ["T"]
      },
      {
        "selector": "objectLiteralProperty",
        "format": null
      },
      {
        "selector": "typeProperty",
        "format": null
      },
      {
        "selector": "classProperty",
        "format": ["camelCase"]
      },
      {
        "selector": "classMethod",
        "format": ["camelCase"]
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 120,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": ["warn", 4],
    "complexity": ["warn", 12],
    "no-nested-ternary": "error",
    "prefer-const": "error",
    "no-else-return": "warn",
    "@typescript-eslint/no-non-null-assertion": "warn",
    "check-file/filename-naming-convention": [
      "error",
      {
        "**/*.constants.ts": "CAMEL_CASE",
        "**/*.interfaces.ts": "CAMEL_CASE",
        "**/*.enums.ts": "CAMEL_CASE",
        "**/*.utils.ts": "CAMEL_CASE",
        "**/*.selectors.ts": "CAMEL_CASE",
        "src/components/**/*.tsx": "PASCAL_CASE",
        "src/features/**/*.tsx": "PASCAL_CASE",
        "src/**/hooks/*.ts": "CAMEL_CASE"
      },
      {
        "ignoreMiddleExtensions": true
      }
    ],
    "check-file/folder-naming-convention": [
      "error",
      {
        "src/**/": "KEBAB_CASE"
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/**/*.ts", "src/**/*.tsx"],
      "excludedFiles": [
        "**/*.interfaces.ts",
        "**/*.enums.ts",
        "**/*.constants.ts",
        "src/app/appStore.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "TSEnumDeclaration",
            "message": "Declare enums in a *.enums.ts file. See docs/conventions.md section 1."
          },
          {
            "selector": "ExportNamedDeclaration > TSInterfaceDeclaration:not([id.name=/Props$/]):not([id.name=/^Use[A-Z].*(Result|Options)$/])",
            "message": "Exported interfaces belong in a *.interfaces.ts file. Component Props and hook Use*Result/Use*Options types stay beside their component or hook. See docs/conventions.md section 5."
          },
          {
            "selector": "ExportNamedDeclaration > TSTypeAliasDeclaration:not([id.name=/Props$/]):not([id.name=/^Use[A-Z].*(Result|Options)$/])",
            "message": "Exported type aliases belong in a *.interfaces.ts file. See docs/conventions.md section 5."
          }
        ]
      }
    },
    {
      "files": ["src/shared/utils/logger.utils.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "check-file/filename-naming-convention": "off"
      }
    },
    {
      "files": ["src/domain/rules/gameEngine.ts"],
      "rules": {
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off"
      }
    },
    {
      "files": ["src/domain/**/*.ts", "src/domain/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "src/domain must stay pure - no React. See docs/architecture.md section 1."
              },
              {
                "name": "react-dom",
                "message": "src/domain must stay pure - no React. See docs/architecture.md section 1."
              },
              {
                "name": "react-redux",
                "message": "src/domain must stay pure - no Redux. See docs/architecture.md section 1."
              },
              {
                "name": "@reduxjs/toolkit",
                "message": "src/domain must stay pure - no Redux. See docs/architecture.md section 1."
              },
              {
                "name": "react-router-dom",
                "message": "src/domain must stay pure - no routing. See docs/architecture.md section 1."
              }
            ],
            "patterns": [
              {
                "group": ["**/features/**", "**/components/**", "**/app/**"],
                "message": "Dependency direction is one-way: domain must not import from features, components, or app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/hooks", "**/app/appStore", "**/features/**"],
                "message": "Presentational components take props and callbacks - no store access. See docs/coding-guidelines.md section 3."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "tests/**/*.ts", "src/setupTests.ts"],
      "env": {
        "node": true
      },
      "globals": {
        "describe": "readonly",
        "it": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "beforeAll": "readonly",
        "afterAll": "readonly",
        "vi": "readonly"
      }
    }
  ]
}
