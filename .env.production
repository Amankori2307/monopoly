# Committed on purpose. Both values are compiled into the JS bundle every
# visitor downloads, so neither is a secret: the publishable key is an
# identifier, and Row Level Security is the actual access control.
#
# The `sb_secret_` key is the opposite - it bypasses RLS entirely - and must
# never appear here, in any other .env, in the bundle, or in CI.
#
# Loaded only in production mode. Vitest runs in mode `test`, so unit tests
# never see these; a plain `.env` would be seen by every mode and is gitignored
# for that reason. See src/features/multiplayer/onlineConfig.utils.ts.
VITE_SUPABASE_URL=https://ohbzjwbcycbvjljffpcw.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_bW-3Vm8qgi4za6s37x5R5A_TFwCJuK-
