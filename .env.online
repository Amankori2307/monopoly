# The same public values as .env.production, for `pnpm dev:online`.
#
# A separate mode rather than putting these in `.env.development`, because the
# e2e suite starts the ordinary dev server and must never reach the network -
# see CLAUDE.md section 8. `development` stays offline; `online` is opt-in.
#
# Committed for the same reason .env.production is: both values are compiled
# into the public bundle, so the publishable key is an identifier and RLS is the
# access control. The sb_secret_ key appears nowhere.
VITE_SUPABASE_URL=https://ohbzjwbcycbvjljffpcw.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_bW-3Vm8qgi4za6s37x5R5A_TFwCJuK-
